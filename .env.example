DATABASE_URL=postgres://varda:varda@localhost:5432/varda
# Better Auth: any random string of 32+ characters (openssl rand -base64 32), and the web app's
# origin, since the web app proxies Better Auth's /api/auth to the API on its own origin.
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-characters
BETTER_AUTH_URL=http://localhost:5173
PORT=4000
# The password of every login account `pnpm db:seed` signs up (anna@varda.test and friends).
VARDA_DEV_PASSWORD=varda-dev-password
