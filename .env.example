DATABASE_URL=postgres://varda:varda@localhost:5432/varda
# The test suites' own database (test:adapters, test:e2e), so tests never write into the one
# `pnpm dev` uses. They migrate it themselves. Created by docker/postgres-init on the first `pnpm db:up`.
TEST_DATABASE_URL=postgres://varda:varda@localhost:5432/varda_test
# Better Auth: any random string of 32+ characters (openssl rand -base64 32), and the web app's
# origin, since the web app proxies Better Auth's /api/auth to the API on its own origin.
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-characters
BETTER_AUTH_URL=http://localhost:5173
PORT=4000
# Local development only: the dev menu in the web app switches persons with no password. Never set when deployed.
VARDA_DEV_MENU=true
# The password of every login account `pnpm db:seed` signs up (anna@varda.test and friends).
VARDA_DEV_PASSWORD=varda-dev-password
# Where the original watch files (recordings) are kept locally, relative to apps/api. Gitignored.
VARDA_RECORDINGS_DIR=./.data/recordings
