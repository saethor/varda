.venv/
.DS_Store
node_modules/
dist/
.turbo/
*.tsbuildinfo
.env

# Local recordings (VARDA_RECORDINGS_DIR).
.data/

# Lingui compiles the catalogs at build time (`lingui compile --strict` only checks them).
apps/web/src/locales/*.js

# Playwright
apps/e2e/test-results/
apps/e2e/playwright-report/

# Impeccable downloads its platform binary on first run.
**/skills/impeccable/scripts/bin/

# Impeccable's per-machine state. `.impeccable/config.json`, `.impeccable/design.json` and
# the surface briefs in `**/.impeccable/surfaces/` are shared and stay tracked; mocks/,
# questions/, review/ and critique/ ignore themselves.
.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/decision-payload.json

# Claude Code's local git worktrees.
.claude/worktrees/
