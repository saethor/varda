    "@orpc/server": "1.16.2",
    "@varda/contract": "workspace:*",
    "@varda/plan": "workspace:*",
    "@varda/record": "workspace:*",
    "@varda/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "pg": "8.23.1",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@orpc/client": "1.16.2",
    "@orpc/contract": "1.16.2",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@varda/config": "workspace:*"
  }
}
