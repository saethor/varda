{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/routeTree.gen.ts",
      "!**/migrations/meta",
      "!**/*.md",
      "!logo",
      "!docs/diagrams",
      "!.claude",
      "!.agents",
      "!.impeccable",
      "!.github/skills"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        }
      },
      "nursery": {
        "useExhaustiveSwitchCases": {
          "level": "error",
          "options": { "requireExplicitCase": true }
        },
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "style": {
        "useThrowOnlyError": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "vitest": {
                "importNames": ["vi"],
                "message": "Fake at ports instead of mocking (CODING_STANDARDS.md, Testing)."
              }
            }
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
