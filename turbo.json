{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "test": {},
    "test:adapters": {
      "cache": false,
      "env": ["TEST_DATABASE_URL", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "VARDA_DEV_PASSWORD"]
    },
    "test:e2e": {
      "cache": false,
      "env": ["TEST_DATABASE_URL", "BETTER_AUTH_SECRET", "VARDA_DEV_PASSWORD", "CI"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
